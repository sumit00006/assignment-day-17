print("\nOUTLIER ANALYSIS")
print("=" * 80)

outlier_results = []

for col in numeric_columns:

    if col not in df.columns:
        continue

    data = df[col].dropna()

    if len(data) < 5:
        continue

    q1 = data.quantile(0.25)
    q3 = data.quantile(0.75)
    iqr = q3 - q1

    lower = q1 - 1.5 * iqr
    upper = q3 + 1.5 * iqr

    count = (
        (data < lower) |
        (data > upper)
    ).sum()

    outlier_results.append([
        col,
        q1,
        q3,
        iqr,
        lower,
        upper,
        count,
        count / len(data) * 100
    ])

outlier_df = pd.DataFrame(
    outlier_results,
    columns=[
        "Variable",
        "Q1",
        "Q3",
        "IQR",
        "Lower_Bound",
        "Upper_Bound",
        "Outlier_Count",
        "Outlier_Percentage"
